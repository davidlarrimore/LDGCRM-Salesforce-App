# Copy this file to .env (gitignored, never commit real values) and fill in
# the values below. Used by scripts/data-migration/Get-AirtableExport.ps1.

# Airtable Personal Access Token -- create one in the Airtable Builder hub
# (avatar menu > Builder hub > Personal access tokens). Needs the
# data.records:read scope at minimum; add schema.bases:read too if you want
# to look up table IDs/names via the metadata API. Must be granted access to
# the base below. Starts with "pat", not the deprecated "key..." API keys.
AIRTABLE_API_KEY=pat...

# Airtable base ID for the Login.gov migration base -- the "app..." string
# in the base's API documentation URL (Help > API documentation) or visible
# in the base's URL when it's open in the browser.
AIRTABLE_BASE_ID=app...
