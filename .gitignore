# ============================================================
# Login.gov CRM Migration - repo-wide ignore rules
# ============================================================
# The sfdx/ project has its own .gitignore for SFDX/CLI artifacts.
# This file covers the automation scripts, run logs, and data
# folders added around it. Run output and data extracts can
# contain Login.gov applicant PII pulled from Airtable or the
# sandbox, so they are excluded by default - only source-controlled
# scripts and documentation should be committed from those trees.

# Script run output (CSV exports, sf CLI JSON, Data Loader success/
# error logs, etc.) - keep folder structure via .gitkeep
logs/**
!logs/**/
!logs/**/.gitkeep
!logs/**/README.md

# Data extracts / Data Loader source & mapping files (may contain PII)
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md

# Salesforce CLI cache, in case `sf` is ever run from the repo root
# instead of sfdx/ (which has its own .gitignore for this already)
/.sf/
/.sfdx/

# Salesforce CLI / Data Loader local config that may embed credentials
**/*.sfdx-token
**/database.conf
**/*.credentials
.env
.env.*
!.env.example

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Generated stakeholder reports. The HTML is the SOURCE and is tracked; the PDF
# is rendered from it by scripts/data-migration/Export-ReportPdf.ps1 and exists
# only because Google Drive shows a standalone .html as raw markup. Tracking
# both meant ~350 KB of binary churn per report for content already in the repo.
# Regenerate before sending: the PDF is not in a fresh clone.
docs/*.pdf

# Salesforce CLI bulk job result files - written to CWD by `sf data bulk results`.
# They contain full record payloads (applicant names, emails, partner notes), so
# they are PII and must never be committed. Same reasoning as logs/ and data/.
750*-success-records.csv
750*-failed-records.csv
