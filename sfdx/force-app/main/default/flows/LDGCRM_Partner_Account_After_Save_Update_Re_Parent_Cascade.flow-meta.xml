<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Cascade updates of Market Segment AND Account if the Partner Account is Re-Parented to a Different Account</description>
    <environments>Default</environments>
    <interviewLabel>LDGCRM : Partner Account : After Save : Update : Re-Parent Cascade {!$Flow.CurrentDateTime}</interviewLabel>
    <label>LDGCRM : Partner Account : After Save : Update : Re-Parent Cascade</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Gets New Account</description>
        <name>Get_New_Account_Record</name>
        <label>Get New Account Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Triggering_Partner_Account_s_Market_Segment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LDGCRM_Account__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Applications</name>
        <label>Update Applications</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Opportunities</targetReference>
        </connector>
        <inputAssignments>
            <field>LDGCRM_Market_Segment__c</field>
            <value>
                <elementReference>Get_New_Account_Record.LDGCRM_Market_Segment__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Applications3__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Updates Child Opportunities</description>
        <name>Update_Opportunities</name>
        <label>Update Opportunities</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>LDGCRM_Market_Segment__c</field>
            <value>
                <elementReference>Get_New_Account_Record.LDGCRM_Market_Segment__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Opportunities__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Updates the Triggering Partner Accounts Market Segment</description>
        <name>Update_Triggering_Partner_Account_s_Market_Segment</name>
        <label>Update Triggering Partner Account&apos;s Market Segment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Applications</targetReference>
        </connector>
        <inputAssignments>
            <field>LDGCRM_Market_Segment__c</field>
            <value>
                <elementReference>Get_New_Account_Record.LDGCRM_Market_Segment__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_New_Account_Record</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>LDGCRM_Account__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>LDGCRM_Partner_Account__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
