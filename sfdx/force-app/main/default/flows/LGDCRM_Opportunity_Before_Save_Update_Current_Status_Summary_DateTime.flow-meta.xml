        <locationY>0</locationY>
        <connector>
            <targetReference>LDGCRM_Opportunity_BeforeSave_UCSSD_UpdateOpptyRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LDGCRM_Current_Status_Summary__c</field>
