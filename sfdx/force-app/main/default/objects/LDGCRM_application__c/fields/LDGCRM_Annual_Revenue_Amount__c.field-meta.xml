<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LDGCRM_Annual_Revenue_Amount__c</fullName>
    <description>Annual Revenue Amount, which is based upon Opportunity Amount</description>
    <formula>IF(
    ISBLANK(LDGCRM_Opportunity__c),
    NULL,
    LDGCRM_Opportunity__r.Amount
)</formula>
