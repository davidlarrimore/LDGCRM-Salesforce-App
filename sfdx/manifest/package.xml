    <!--
        Starter manifest for pulling the Login.gov CRM data model and app
        config out of the gsa-peo sandbox with the Salesforce CLI:

            sf project retrieve start -x manifest/package.xml -o gsa-peo

        Add members/types as the app grows (new custom objects, flows,
        permission sets, etc.). Members are listed explicitly rather than
        with wildcards ("*") because this sandbox hosts several unrelated
        apps (e.g. FCIC) that share these metadata types - a wildcard here
        would pull in components with no relation to the LDGCRM app.
    -->
    <types>
        <members>Account</members>
        <members>Activity</members>
        <members>Contact</members>
        <members>Opportunity</members>
        <members>OpportunityContactRole</members>
        <members>LDGCRM_Partner_account__c</members>
        <members>LDGCRM_Application__c</members>
        <members>LDGCRM_Application_Contact__c</members>
        <members>LDGCRM_Impediment__c</members>
        <members>LDGCRM_Opportunity_Impediment__c</members>
        <members>LDGCRM_Market_Segment__c</members>
        <!-- LDGCRM_Issuer_String__c was created in Dev on 2026-09-08, AFTER the
             production change set was built, so production does not have it. It is
             a Master-Detail child of LDGCRM_application__c, and it replaces the
             Text(40) field LDGCRM_application__c.LDGCRM_PP_Issuer_Strings__c,
             which was deleted from Dev on 2026-09-09 and is gone from this repo.
             PRODUCTION STILL HAS THAT FIELD, and a sandbox refresh restores it -
             it came back once already. LDGCRM_Partnership_Portal_API_R grants read
             on this object, so a change set carrying that permission set needs
             this object alongside it. -->
        <members>LDGCRM_Issuer_String__c</members>
        <name>CustomObject</name>
    </types>
